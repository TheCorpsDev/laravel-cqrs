{
    "name": "thecorps/laravel-cqrs",
    "description": "Lightweight CQRS pipeline infrastructure for Laravel applications using PHP 8 attributes",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cqrs", "command-bus", "query-bus", "pipeline", "attributes"],
    "authors": [
        {
            "name": "Gabriele Privitera",
            "email": "gabriele.pr.01@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/log": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "TheCorps\\LaravelCqrs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheCorps\\LaravelCqrs\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheCorps\\LaravelCqrs\\CqrsServiceProvider"
            ],
            "aliases": {
                "CommandBus": "TheCorps\\LaravelCqrs\\Facades\\CommandBus",
                "QueryBus": "TheCorps\\LaravelCqrs\\Facades\\QueryBus"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
